<fragment>
  <!-- Audience validation is pinned. Before deployment, {{external-id-api-audience}}
       must resolve to the API's real Application ID URI in each country's APIM
       instance; a missing or incorrect value locks out every citizen. -->
  <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-scheme="Bearer">
    <openid-config url="{{external-id-openid-config-url}}" />
    <audiences>
      <audience>{{external-id-api-audience}}</audience>
    </audiences>
    <required-claims>
      <claim name="scp" match="any" separator=" ">
        <value>access_as_user</value>
      </claim>
    </required-claims>
  </validate-jwt>
</fragment>
